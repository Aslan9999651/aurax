# ================= AuraX Backend — Supabase (PostgreSQL) =================
# 1) افتح لوحة Supabase ← اضغط زر Connect بالأعلى ← اختر "Session pooler"
# 2) انسخ سلسلة الاتصال واستبدل [YOUR-PASSWORD] بكلمة مرور قاعدة البيانات
#    (Project Settings ← Database ← Database password)
# صيغة الرابط (استبدل REGION بالمنطقة الظاهرة عندك مثل eu-central-1):
DATABASE_URL=postgresql://postgres.txfbymcnrccquwswhgxe:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres

# مرجع مشروع Supabase (للتوثيق فقط — الباكند يتصل عبر DATABASE_URL)
SUPABASE_URL=https://txfbymcnrccquwswhgxe.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_E7bbkcNhvUBMvdixpm1hbg_eYJE1twi

# سر توقيع الجلسات (غيّره إلى نص عشوائي طويل)
JWT_SECRET=change-this-to-a-long-random-string

# حساب الأدمن الافتراضي (يُنشأ تلقائياً عند أول تشغيل)
ADMIN_EMAIL=admin@aurax.io
ADMIN_PASSWORD=AuraX@Admin2026

# اسم مُرسل البريد + مفتاح البريد (اختياري لإرسال رموز التحقق)
EMAIL_FROM_NAME=AuraX
# EMERGENT_EMAIL_KEY=

# مفتاح CoinGecko (اختياري لرفع حدود الأسعار)
